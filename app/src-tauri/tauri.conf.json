{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kotonoha",
  "version": "1.0.1",
  "identifier": "dev.kotonoha.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Local, private voice input",
    "copyright": "Copyright (c) 2026 Kotonoha contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": null,
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "languages": [
          "Japanese",
          "English"
        ]
      }
    }
  }
}
